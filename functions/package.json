{
  "name": "goen-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud Functions for 碁縁 (GoEn) — AI game-review generation, the weekly auto-tournament scheduler, and push notification delivery.",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "tsc && node --test lib/sgf.test.js lib/weeklyTournament.test.js lib/pushNotifications.test.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.4.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
