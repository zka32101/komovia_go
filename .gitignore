# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# iOS/macOS
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/*sync/
**/ios/**/.sconsign.dblite
**/ios/**/.tags*
**/ios/**/.vagrant/
**/ios/**/DerivedData/
**/ios/**/Icon?
**/ios/**/Icon?*
**/ios/**/KeyStore
**/ios/**/LocalPackages/
**/ios/**/Packages
**/ios/**/Pod.lock
**/ios/**/Pods/
**/ios/**/Podfile.lock
**/ios/**/xcshareddata/
**/ios/**/xcuserdata/
**/ios/.generated/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/macos/Flutter/GeneratedPluginRegistrant.swift

# Android/gradle
# Note: Gradle wrapper files (gradlew, gradlew.bat, gradle-wrapper.jar) ARE committed for CI/CD
# Only ignore gradle-wrapper.jar if truly needed; wrapper files should be in VCS
**/android/.gradle
**/android/captures/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
**/*.jks
**/*.keystore

# Web platform

# build_runner output (freezed/json_serializable) - regenerated by
# `dart run build_runner build`, not meant to be committed.
**/*.freezed.dart
**/*.g.dart

# l10n output - regenerated from lib/l10n/*.arb by `flutter gen-l10n`
# (run automatically before build/run since flutter: generate: true).
lib/l10n/app_localizations.dart
lib/l10n/app_localizations_*.dart

# Exceptions to above rules.
!/packages/flutter_tools/test/data/dart_dependencies_test/**/.packages
